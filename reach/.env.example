# Postgres (Supabase). DATABASE_URL = pooled (port 6543, add ?pgbouncer=true&connection_limit=5); DIRECT_URL = direct (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32

# Google OAuth web client (Internal consent screen, hackutd.co org)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain that may sign in
ALLOWED_DOMAIN=hackutd.co
# First sign-in with this email becomes admin
ADMIN_EMAIL=

# AES-256-GCM key for stored refresh tokens: openssl rand -base64 32
ENCRYPTION_KEY=

# Bearer token for /api/cron/* routes
CRON_SECRET=
